# ============================================================
# sEMG_B_Project .gitignore  (v3 · 2026-08-06 整理，适配 docs/ 新目录结构)
# 原则：只上传「核心源码 + 正式文档」，其余本地保留不传。
# ============================================================

# ---------- 构建产物 (Firmware) ----------
.pio/
firmware/.pio/
compile_commands.json
lib/

# ---------- 依赖 (Python / Node) ----------
__pycache__/
**/__pycache__/
*.pyc
node_modules/
firmware/node_modules/
mini_program/node_modules/
mini_program/miniprogram_npm/

# ---------- IDE ----------
.vscode/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.idea/

# ---------- 操作系统 ----------
Thumbs.db
.DS_Store

# ---------- 运行时 / Agent 工作区 (本地，不传) ----------
logs/
temp/
scripts/
Claw/
.workbuddy/
agent_records/
.trae/

# ---------- 临时 / 草稿 ----------
temp_skill_md/
_tmp_*/
*.ps1
*.bak
*~
*.log
debug.log

# docx-toolkit 运行时产物（临时中间文件 + 进程锁，不应入库）
.toolkit.lock
docs/_tmp_*
docs/tmp*

# ---------- 私有配置 (含环境 ID / 密钥) ----------
project.private.config.json
cloudbaserc.json
mini_program/cloudbaserc.json

# ---------- 非核心文档 (本地保留，不传 GitHub) ----------
# docs/ 根目录的正式交付物照常上传：研究日志/硬件说明/肌电算法说明/软件设计（各 *.docx+*.md）+ 论文.docx；
# 其余本地归档/辅助文档一律不传：
#   - 各主题历史备份：docs/*备份/（论文备份/研究日志备份/硬件说明备份/肌电算法说明备份/软件设计备份）
#   - 早期/辅助文档：docs/其他文档/
#   - 参考资料整目录：docs/资料/
# 如需把硬件手册也传 GitHub，取消下一行注释并加白名单：
#   !docs/资料/芯片手册/
docs/资料/
docs/*备份/
docs/其他文档/

# ---------- 杂项 ----------
# Windows 保留名误生成的空文件，不传
nul
