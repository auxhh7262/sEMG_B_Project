# ============================================================
# sEMG_B_Project .gitignore  (v2 · 2026-07-16 整理)
# 原则：只上传「核心源码 + 正式文档」，其余本地保留不传。
# ============================================================

# ---------- 构建产物 (Firmware) ----------
.pio/
firmware/.pio/
compile_commands.json
lib/

# ---------- 依赖 (Python / Node) ----------
__pycache__/
**/__pycache__/
*.pyc
node_modules/
firmware/node_modules/
mini_program/node_modules/
mini_program/miniprogram_npm/

# ---------- IDE ----------
.vscode/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.idea/

# ---------- 操作系统 ----------
Thumbs.db
.DS_Store

# ---------- 运行时 / Agent 工作区 (本地，不传) ----------
logs/
temp/
scripts/
Claw/
.workbuddy/
agent_records/
.trae/

# ---------- 临时 / 草稿 ----------
temp_skill_md/
*.ps1
*.bak
*~
*.log
debug.log

# ---------- 私有配置 (含环境 ID / 密钥) ----------
project.private.config.json
cloudbaserc.json
mini_program/cloudbaserc.json

# ---------- 非核心文档 (本地保留，不传 GitHub) ----------
# docs/ 根目录的 4 份正式交付物（*.md / *.docx）照常上传；
# 其余所有文档统一收在 docs/资料/，整目录不传。
# 如需把硬件手册也传 GitHub，取消下一行注释并加白名单：
#   !docs/资料/芯片手册/
docs/资料/

# ---------- 杂项 ----------
# Windows 保留名误生成的空文件，不传
nul
